# PostgreSQL connection used by the desktop application
DB_HOST=127.0.0.1
DB_PORT=55432
DB_NAME=yacht_club_manager
DB_USER=yacht_app
DB_PASSWORD=CHANGE_ME_APP_PASSWORD

# Bootstrap-only PostgreSQL superuser and restricted application role
POSTGRES_ADMIN_USER=yacht_admin
POSTGRES_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
POSTGRES_APP_USER=yacht_app
POSTGRES_APP_PASSWORD=CHANGE_ME_APP_PASSWORD

# Start the local PostgreSQL service through Docker Compose when needed
AUTO_START_DOCKER=true

# Open-Meteo forecast coordinates (Crimea / Black Sea coast)
WEATHER_LATITUDE=44.95
WEATHER_LONGITUDE=34.10
